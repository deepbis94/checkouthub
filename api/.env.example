APP_NAME=CheckoutHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=checkouthub
DB_USERNAME=checkouthub
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=checkouthub

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=checkouthub_

CHECKOUTHUB_WORKER_TOKEN=checkouthub-worker-dev-token
CHECKOUTHUB_CHARGE_LOCK_TTL_MS=15000
CHECKOUTHUB_CB_THRESHOLD=5
CHECKOUTHUB_CB_WINDOW_MS=60000
CHECKOUTHUB_CB_COOLDOWN_MS=15000
CHECKOUTHUB_CB_PROBE_TTL_MS=5000

STRIPE_ENABLED=true
STRIPE_MODE=simulate
STRIPE_PRIORITY=1
STRIPE_SECRET=
STRIPE_SIMULATE_FAILURE=false

RAZORPAY_ENABLED=true
RAZORPAY_MODE=simulate
RAZORPAY_PRIORITY=2
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_SIMULATE_FAILURE=false
